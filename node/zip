OLD_DIR="$(pwd)"
DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd $DIR

[ -f infra.json ] || { echo "Falta node/infra.json: correr terraform apply"; exit 1; }

# zip agrega al archivo existente: sin borrarlo quedan adentro los archivos que ya no estan
rm -f src.zip
zip -r src.zip *.js *.json metrics repository state/*.json tools -1 || exit 1

cd $OLD_DIR
